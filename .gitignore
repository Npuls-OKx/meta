# Archi backup (lokaal)
architecture/model/*.bak

# Tijdelijke modelbestanden voor een Archi model-import (bij conflictherstel).
# Zie https://github.com/Npuls-OKx/Public/blob/dev/Referentiemateriaal/adr/0010-archimatemodel-werkafspraken.md
architecture/model/_import_*.archimate

# =========================
# macOS
# =========================
.DS_Store
._*

# Slidev: afhankelijkheden en build-output van de presentaties
presentaties/node_modules/
presentaties/**/node_modules/
presentaties/dist/
presentaties/.slidev/
# Wordt uit het Npuls-sjabloon gebouwd door bouw-pandoc-referentie.py
presentaties/src/templates/npuls-pandoc-referentie.pptx

# Exports: de deelbare bestanden horen in de repository, de losse
# afbeeldingen en statische sites niet; die lopen in de tientallen MB's.
presentaties/export/*
!presentaties/export/*/
presentaties/export/*/*
!presentaties/export/*/*.pdf
!presentaties/export/*/*.pptx

# Python
__pycache__/
*.pyc

# Bronmateriaal dat nog niet gepubliceerd mag worden: een payload van een leverancier of een
# instelling blijft hier tot de inbrenger zegt dat het de repository in mag. Alles in deze map
# blijft lokaal; de plaat die eruit getekend wordt kan wel een commit in.
_lokaal/
