        <element xsi:type="archimate:DataObject" name="Code Kerntaak" id="id-14a88edfdfee4defbe185b54983b6606">
          <documentation>Format B[0..R]-K[0...R] of P[0...R]-K[0....R]. Waar B staat voor de basisdeelcode en P staat voor de profieldeelcode en K staat voor de kerntaakcode.&#xD;
&#xD;
RegEx: ^[BP][0-R]-K[0-R]$&#xD;
</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="Code Kwalificatie dossier" id="id-606eba88e1d548a18860e0b4e091cabd">
          <documentation>Format: B[0..R]-K[0...R] of P[0...R]-K[0....R], gevolgd door -W[0...R]. Waar B staat voor de basisdeelcode, P staat voor de profieldeelcode, K staat voor de kerntaakcode en W staat voor de werkprocescode.&#xD;
&#xD;
RegEx: ^[BP][0-R]-K[0-R]-W[0-R]$&#xD;
&#xD;
</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="Code onderwijsprogramma" id="id-549a0fede4874bbc93af13e05fd03ea2"/>
        <element xsi:type="archimate:DataObject" name="Code Werkproces" id="id-562646e6a86543c9a7a1da6f5aaecae4">
          <documentation>Format: B[0..R]-K[0...R] of P[0...R]-K[0....R], gevolgd door -W[0...R]. Waar B staat voor de basisdeelcode, P staat voor de profieldeelcode, K staat voor de kerntaakcode en W staat voor de werkprocescode.&#xD;
&#xD;
RegEx: ^[BP][0-R]-K[0-R]-W[0-R]$&#xD;
&#xD;
</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="CohortAanduiding" id="id-3974eebc1040446a911376695bf82f35" profiles="id-79bd49cdd8d24a33ab77a770d8ec5701">
          <documentation>Nominale periode waarbinnen het cohort actief onderwijs volgt. Start periode (per kwartaal, maand, week, dag) tot Afronding nominaal programma.&#xD;
Schooljaar format: 2025-2026. (altijd 2 jaren in combinatie).</documentation>
          <property key="startJaar" value="Jaartal"/>
          <property key="instroomMoment" value="Maand / Periode indicatie"/>
        </element>
        <element xsi:type="archimate:DataObject" name="Cohort gegevens" id="id-f7b574c5f52d4f26994251b30cc1e39a" profiles="id-7427bf90987b4f97b0b2f3e2b440b6cd"/>
        <element xsi:type="archimate:DataObject" name="Contactgegevens Onderwijslocatie" id="id-590a09ec5d4e4d45a541e40e6d0beab9"/>
        <element xsi:type="archimate:DataObject" name="CREBO-nummer Kwalificatie" id="id-d55c23d1beae4c088dc13dbfe4d21342">
          <documentation>23000 nummers identificeren Dossiers. Dossiers aggregreren in feite meerdere kwalificaties / profielen.&#xD;
25000 nummers identificeren CREBO's / kwalificatie&#xD;
Binnen CREBO heb je basis en profieldelen. &#xD;
Deze nummers houden relatie tot de werkprocessen en kerntaken. Kwalificaties met vergelijkbare CREBO nummers kunnen overlap in kernprocessen en werkprocessen hebben.</documentation>
        </element>
