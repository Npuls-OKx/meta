        <element xsi:type="archimate:BusinessObject" name="Beoordeling" id="id-51a1ec6086054de2ad3b1b09039da5a7">
          <documentation>Formatief / summatief maakt geen zak uit onderwijskundig gezien.</documentation>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Beoordeling / Resultaat" id="id-03f9dda0f78b47f1906448bb1779a447"/>
        <element xsi:type="archimate:BusinessObject" name="Beordelingsmodel" id="id-fd9ce43448134efdad2c84d251854c3c">
