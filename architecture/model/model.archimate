                <bounds x="5484" y="92" width="185" height="37"/>
                <content>Examen instrument</content>
              </child>
              <child xsi:type="archimate:Note" id="id-482680ad7df5462f937f4290510263bb" textAlignment="1">
                <bounds x="5808" y="84" width="185" height="80"/>
