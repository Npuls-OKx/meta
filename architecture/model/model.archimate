      <folder name="OKx" id="id-2cf8d426f3d0402ca0b9224228ba6665">
        <element xsi:type="archimate:DataObject" name="Adminisrtatieve status van Opleidingsonderdeel" id="id-a3de36d70128454584a011619f0bc729">
          <documentation>In ontwikkeling, goedgekeurd, vervallen</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="Administratieve status van onderwijsprogramma" id="id-88e4ef7720794fa8aa55a7b480373487"/>
