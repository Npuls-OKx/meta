          <child xsi:type="archimate:Note" id="id-1a9595e59c6e47c8ba4fa2913449e2ce" textAlignment="1">
            <bounds x="-1586" y="2592" width="267" height="97"/>
            <content>Grof en fijn ontwerp moeten hier plaats vinden.&#xD;
&#xD;
Je gaat uiteindelijk WAT en HOE zo ver mogelijk uitgewerkt uitwisselen met OC.&#xD;
Daarna ga je kijken of je die kunt plannen.</content>
          </child>
          <child xsi:type="archimate:Note" id="id-4bc2e27029214c2b96944ebd6daaa16f" textAlignment="1">
            <bounds x="-1428" y="3360" width="329" height="80"/>
            <content>Deze twee kloppen misschien niet&#xD;
</content>
          </child>
          <child xsi:type="archimate:DiagramObject" id="id-c6f0cdf25654416987ffa93a2efb51cf" targetConnections="id-a67bb1ca0cc54363a38867e3aa168559 id-c52499c416ef4d1185ce6d556d78f340 id-78bfe7dd0d2e4fc3bd3c251337b77de9 id-eb77797cf4c4438c9ffa4eeba80c928a" archimateElement="id-6345c675bc9b4537a02f27378537e70b">
