          <child xsi:type="archimate:DiagramObject" id="id-eaf65b1c893f46bdadee05e6331d85d4" targetConnections="id-c38e10111c4d48e09483a75e8c1899b8" archimateElement="id-78273ca426784fa88b7d5b933f229432">
