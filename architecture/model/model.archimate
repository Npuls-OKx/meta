        <element xsi:type="archimate:DataObject" name="Resultaatformat" id="id-403410eb34b84ffab3cf660f3f2df64c">
          <documentation>Dit is een geformatteerd resultaat dat je kunt verwachten voor een student op een bepaalde toets, t.b.h.v check op resultaten structuur passendheid.</documentation>
        </element>
        <element xsi:type="archimate:DataObject" name="Resultaat omschrijving Werkproces" id="id-50ed04d524954375a308fc978da2ed19"/>
