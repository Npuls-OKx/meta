          <property key="Integriteit" value="Midden"/>
          <property key="Vertrouwelijkheid" value="Hoog"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Lesmateriaal" id="id-d875828568f34447a07eacb7f489a1df">
