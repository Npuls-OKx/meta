</documentation>
          <property key="Beschikbaarheid" value="Midden"/>
          <property key="Integriteit" value="Midden"/>
          <property key="Vertrouwelijkheid" value="Laag"/>
        </element>
        <element xsi:type="archimate:BusinessObject" name="Examendossier" id="id-daf5597da8614c5da32c528ed3badd6c">
