  </folder>
  <folder name="Technology &amp; Physical" id="95a4fa43-449c-4a08-ab39-2ad47db0ff17" type="technology">
    <folder name="OOAPI v6 models" id="id-7713d29b05e64cee91e0be94be7267dd">
      <element xsi:type="archimate:Artifact" name="Association" id="id-cc0b39ceb9074b3399fee116456c1fee">
        <documentation>Een OOAPI mapping element, dat Personen aan specifieke instanties van componenten kan koppelen.&#xD;
&#xD;
Mapping via Component ID &lt;> PersonID (?)</documentation>
      </element>
      <element xsi:type="archimate:Artifact" name="Person" id="id-68b7b7a38c4a46808f9f676834c89292"/>
