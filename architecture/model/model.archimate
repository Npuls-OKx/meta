            <child xsi:type="archimate:Note" id="id-2aca634f19e044c5ad8f0ffcdb234d97" textAlignment="1">
              <bounds x="636" y="-48" width="185" height="80"/>
              <content>Is de leervorm niet een enorm specifiek iets? gebeurt dit niet in het OC? net als leertaak?</content>
            </child>
